{
  "$schema": "https://schema.tauri.app/config/2.0.0",
  "productName": "BRAIN",
  "version": "0.2.16",
  "identifier": "eu.poletto.brain",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "BRAIN",
        "label": "main",
        "width": 1100,
        "height": 720,
        "minWidth": 800,
        "minHeight": 600,
        "decorations": true,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "category": "Productivity",
    "shortDescription": "BRAIN — personal knowledge system",
    "longDescription": "BRAIN is a personal knowledge management system that lives on a portable SSD or local folder."
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/PPoletto/BRAIN/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNGREYwMkVGMDlGOTMzREEKUldUYU0va0o3d0xmUHpnU01WY2pOL2cwY1g5Z2dpUVJ3WjhNWXRqRUpuQW1HR1pGOXRud0ZJWFIK",
      "windows": {
        "installMode": "quiet"
      }
    }
  }
}
