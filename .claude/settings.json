    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(~/.claude.json)",
      "Read(~/.codex/**)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(/etc/**)",
      "Read(../**)",
      "Edit(../**)",
      "Write(../**)",
      "Bash(cd ..*)",
      "Bash(cd ~*)",
      "Bash(cd /*)",
      "Bash(rm -rf:*)",
      "Bash(sudo:*)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(ssh:*)",
      "Bash(scp:*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git reset --hard*)",
      "Bash(git filter-branch*)",
      "Bash(git filter-repo*)"
    ]
  },
  "attribution": {
    "coAuthor": "",
    "trailerComment": ""
  }
